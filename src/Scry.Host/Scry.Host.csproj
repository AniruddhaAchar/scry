<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- scryd — the long-lived host daemon. Loads one dump (from M1 onward) and
       serves analysis commands over gRPC on a dump-derived endpoint. -->
  <PropertyGroup>
    <AssemblyName>scryd</AssemblyName>
    <RootNamespace>Scry.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scry.Contracts\Scry.Contracts.csproj" />
    <ProjectReference Include="..\Scry.Core\Scry.Core.csproj" />
  </ItemGroup>

</Project>
