<Project>

  <!-- Solution-wide build settings. Applied to every project unless overridden. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Single source of truth for the product version: drives every assembly, the
         tool package version, and ScryVersion.Current (read back via reflection). -->
    <Version>0.1.1</Version>

    <!-- All warnings are errors, comprehensively:
         - TreatWarningsAsErrors promotes compiler, CA analyzer, and NuGet (NU*) warnings.
         - EnforceCodeStyleInBuild runs the code-style (IDE*) analyzers at build time,
           so .editorconfig violations fail the build (and CI), not just `dotnet format`.
         - Generated code (e.g. protobuf under obj/) is auto-excluded from style analysis. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible restores: every project gets a committed packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Central Package Management is enabled in Directory.Packages.props. -->
  </PropertyGroup>

</Project>
