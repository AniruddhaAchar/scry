<Project>

  <!-- Solution-wide build settings. Applied to every project unless overridden. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Reproducible restores: every project gets a committed packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Central Package Management is enabled in Directory.Packages.props. -->
  </PropertyGroup>

</Project>
