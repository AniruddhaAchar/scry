# Normalize all text files to LF in the repository and working tree on every
# platform. This keeps .editorconfig's `end_of_line = lf` consistent with what's
# checked out, so `dotnet format --verify-no-changes` passes on Windows too.
* text=auto eol=lf

# Explicit binaries (never normalize).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.dmp binary
*.dump binary
